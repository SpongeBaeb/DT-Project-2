{
  "name": "sea-marksman-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../contracts/generated/openapi.json -o src/api/schema.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.4.4",
    "typescript": "5.5.4",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
